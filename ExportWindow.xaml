<Window x:Class="KrakhmalovSheets.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMLEADERS Sheets" Width="1280" Height="850" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#ECECEC" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#EAB143"/>
        <SolidColorBrush x:Key="AccentDark" Color="#C88B16"/>
        <SolidColorBrush x:Key="Line" Color="#B9B9B9"/>
        <SolidColorBrush x:Key="SoftLine" Color="#D7D7D7"/>
        <SolidColorBrush x:Key="Panel" Color="#F4F4F4"/>
        <SolidColorBrush x:Key="SelectedRow" Color="#D9EAF7"/>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="13,4"/>
            <Setter Property="Background" Value="#E4E4E4"/>
            <Setter Property="BorderBrush" Value="#B5B5B5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#3A3A3A"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDark}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,13,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,13,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,14,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#C8D3DA"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#F7F7F7"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#C7C7C7"/>
            <Setter Property="VerticalGridLinesBrush" Value="#C7C7C7"/>
            <Setter Property="RowHeight" Value="35"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedRow}"/>
                    <Setter Property="Foreground" Value="#202020"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#B7B7B7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#ECECEC" BorderBrush="#C4C4C4" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BIMLEADERS Sheets" FontSize="27" FontWeight="Bold" Foreground="#373737"/>
                    <Border Margin="12,0,0,0" Padding="10,5" Background="#F7F7F7" BorderBrush="#C2C2C2" BorderThickness="1">
                        <TextBlock Text="LOCAL EXPORT" Foreground="#7A7A7A"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="BIMLEADERS Sheets 1.3.0" FontSize="16" Foreground="#575757" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ProfileCombo" Width="185" SelectionChanged="ProfileChanged"/>
                    <Button Style="{StaticResource IconButton}" Content="+" Margin="7,0,0,0" ToolTip="New profile" Click="NewProfile"/>
                    <Button Content="Save" Margin="5,0,0,0" ToolTip="Save profile" Click="SaveProfile"/>
                    <Button Content="Delete" Margin="5,0,0,0" ToolTip="Delete profile" Click="DeleteProfile"/>
                    <Button Content="Import" Margin="5,0,0,0" ToolTip="Import profile" Click="ImportProfile"/>
                    <Button Content="Export" Margin="5,0,0,0" ToolTip="Export profile" Click="ExportProfileFile"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <TabControl x:Name="Steps" Grid.Row="1" Margin="14,0,14,0" SelectionChanged="StepChanged" Background="#F7F7F7">
            <TabItem Header="Selection">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,5,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="250" MinWidth="160"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <RadioButton x:Name="SheetsMode" Content="Sheets" FontSize="15" IsChecked="True" Checked="SelectionFilterChanged"/>
                                <RadioButton x:Name="ViewsMode" Content="Views" FontSize="15" Checked="SelectionFilterChanged"/>
                                <RadioButton x:Name="AllMode" Content="View/Sheet Set" FontSize="15" Checked="SelectionFilterChanged"/>
                            </StackPanel>
                            <ComboBox x:Name="SelectionSetCombo" Width="220" Margin="0,3,8,3" SelectionChanged="SelectionSetChanged"/>
                            <Button x:Name="SelectionSetMenuButton" Content="Save V/S Set  v" Margin="0,3,8,3" Padding="8,3" Click="OpenSelectionSetMenu">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="New Revit Set" Click="SaveSelectionSet"/>
                                    <MenuItem Header="Add to Revit Set" Click="AddToSelectionSet"/>
                                    <Separator/>
                                    <MenuItem Header="Delete Revit Set" Click="RemoveSelectionSet"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            </Button>
                        </WrapPanel>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,3,0,3" ToolTip="Search by number or name" TextChanged="SearchChanged"/>
                    </Grid>

                    <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Width="45" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Sheet Number" Width="160" Binding="{Binding Number}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sheet Name" Width="*" Binding="{Binding Name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Revision" Width="155" Binding="{Binding Revision}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Size" Width="155" Binding="{Binding Size}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Custom File Name" Width="310" Binding="{Binding CustomFileName, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Select visible" Height="29" MinHeight="29" Click="SelectVisible"/>
                            <Button Content="Clear" Height="29" MinHeight="29" Margin="6,0,0,0" Click="ClearSelection"/>
                        </StackPanel>
                        <CheckBox x:Name="ActiveOnlyCheck" Grid.Column="1" Content="Show only active Sheets/Views" Checked="SelectionFilterChanged" Unchecked="SelectionFilterChanged"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Format">
                <Grid Margin="18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Width="118">
                            <CheckBox x:Name="PdfCheck" Checked="FormatChanged" Unchecked="FormatChanged"/>
                            <Border Width="72" Height="70" Background="#F8F9F9" BorderBrush="#BCC8C9" BorderThickness="1" Padding="5">
                                <StackPanel><TextBlock Text="FILE" Foreground="#A9B5B7"/><TextBlock Text="PDF" FontSize="16" FontWeight="Bold" Foreground="#E2A72F" HorizontalAlignment="Center" Margin="0,13,0,0"/></StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Width="118"><CheckBox x:Name="DwgCheck" Checked="FormatChanged" Unchecked="FormatChanged"/><Border Width="72" Height="70" Background="#F8F9F9" BorderBrush="#BCC8C9" BorderThickness="1" Padding="5"><StackPanel><TextBlock Text="FILE" Foreground="#A9B5B7"/><TextBlock Text="DWG" FontSize="16" FontWeight="Bold" Foreground="#E2A72F" HorizontalAlignment="Center" Margin="0,13,0,0"/></StackPanel></Border></StackPanel>
                        <StackPanel Orientation="Horizontal" Width="118"><CheckBox x:Name="DgnCheck" Checked="FormatChanged" Unchecked="FormatChanged"/><Border Width="72" Height="70" Background="#F8F9F9" BorderBrush="#BCC8C9" BorderThickness="1" Padding="5"><StackPanel><TextBlock Text="FILE" Foreground="#A9B5B7"/><TextBlock Text="DGN" FontSize="16" FontWeight="Bold" Foreground="#E2A72F" HorizontalAlignment="Center" Margin="0,13,0,0"/></StackPanel></Border></StackPanel>
                        <StackPanel Orientation="Horizontal" Width="118"><CheckBox x:Name="DwfCheck" Checked="FormatChanged" Unchecked="FormatChanged"/><Border Width="72" Height="70" Background="#F8F9F9" BorderBrush="#BCC8C9" BorderThickness="1" Padding="5"><StackPanel><TextBlock Text="FILE" Foreground="#A9B5B7"/><TextBlock Text="DWF" FontSize="16" FontWeight="Bold" Foreground="#E2A72F" HorizontalAlignment="Center" Margin="0,13,0,0"/></StackPanel></Border></StackPanel>
                        <StackPanel Orientation="Horizontal" Width="118"><CheckBox x:Name="NwcCheck" Checked="FormatChanged" Unchecked="FormatChanged"/><Border Width="72" Height="70" Background="#F8F9F9" BorderBrush="#BCC8C9" BorderThickness="1" Padding="5"><StackPanel><TextBlock Text="FILE" Foreground="#A9B5B7"/><TextBlock Text="NWC" FontSize="16" FontWeight="Bold" Foreground="#E2A72F" HorizontalAlignment="Center" Margin="0,13,0,0"/></StackPanel></Border></StackPanel>
                        <StackPanel Orientation="Horizontal" Width="118"><CheckBox x:Name="IfcCheck" Checked="FormatChanged" Unchecked="FormatChanged"/><Border Width="72" Height="70" Background="#F8F9F9" BorderBrush="#BCC8C9" BorderThickness="1" Padding="5"><StackPanel><TextBlock Text="FILE" Foreground="#A9B5B7"/><TextBlock Text="IFC" FontSize="16" FontWeight="Bold" Foreground="#E2A72F" HorizontalAlignment="Center" Margin="0,13,0,0"/></StackPanel></Border></StackPanel>
                        <StackPanel Orientation="Horizontal" Width="118"><CheckBox x:Name="ImageCheck" Checked="FormatChanged" Unchecked="FormatChanged"/><Border Width="72" Height="70" Background="#F8F9F9" BorderBrush="#BCC8C9" BorderThickness="1" Padding="5"><StackPanel><TextBlock Text="FILE" Foreground="#A9B5B7"/><TextBlock Text="IMG" FontSize="16" FontWeight="Bold" Foreground="#E2A72F" HorizontalAlignment="Center" Margin="0,13,0,0"/></StackPanel></Border></StackPanel>
                        <StackPanel Orientation="Horizontal" Width="118"><CheckBox x:Name="XmlCheck" Checked="FormatChanged" Unchecked="FormatChanged"/><Border Width="72" Height="70" Background="#F8F9F9" BorderBrush="#BCC8C9" BorderThickness="1" Padding="5"><StackPanel><TextBlock Text="FILE" Foreground="#A9B5B7"/><TextBlock Text="XML" FontSize="16" FontWeight="Bold" Foreground="#E2A72F" HorizontalAlignment="Center" Margin="0,13,0,0"/></StackPanel></Border></StackPanel>
                    </WrapPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel>
                        <StackPanel Width="370">
                            <GroupBox Header="Paper Placement" Height="165">
                                <StackPanel>
                                    <RadioButton x:Name="CenterPlacement" GroupName="PaperPlacement" Content="Center" IsChecked="True" Checked="OptionStateChanged"/>
                                    <StackPanel Orientation="Horizontal"><RadioButton x:Name="OffsetPlacement" GroupName="PaperPlacement" Content="Offset from corner" Checked="OptionStateChanged"/><ComboBox x:Name="OffsetCornerCombo" Width="150"><ComboBoxItem Content="No Margin"/></ComboBox></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="28,8,0,0"><TextBlock Text="X =" VerticalAlignment="Center"/><TextBox x:Name="OffsetXBox" Width="78" Margin="6,0,8,0" Text="0.00"/><TextBlock Text="Y =" VerticalAlignment="Center"/><TextBox x:Name="OffsetYBox" Width="78" Margin="6,0,0,0" Text="0.00"/><TextBlock Text=" mm" VerticalAlignment="Center"/></StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Zoom" Height="130">
                                <StackPanel><RadioButton x:Name="FitToPageRadio" GroupName="ZoomMode" Content="Fit to Page" IsChecked="True" Checked="OptionStateChanged"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="ZoomRadio" GroupName="ZoomMode" Content="Zoom" Checked="OptionStateChanged"/><TextBox x:Name="ZoomPercentBox" Width="70" Text="100"/><TextBlock Text=" %" VerticalAlignment="Center"/></StackPanel></StackPanel>
                            </GroupBox>
                            <GroupBox Header="PDF engine" Height="255">
                                <StackPanel>
                                    <TextBlock Text="Exporter / printer" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="PrinterCombo" SelectionChanged="PrinterChanged"/>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Driver paper size"/><ComboBox x:Name="PrinterPaperSizeCombo" IsEditable="True"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Paper source"/><ComboBox x:Name="PrinterPaperSourceCombo" IsEditable="True"/></StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,7,0,0">
                                        <TextBlock Text="Copies" VerticalAlignment="Center"/><TextBox x:Name="PrinterCopiesBox" Width="48" Text="1" Margin="6,0,10,0"/>
                                        <CheckBox x:Name="PrinterCollateCheck" Content="Collate"/>
                                        <CheckBox x:Name="PrinterReverseCheck" Content="Reverse"/>
                                        <CheckBox x:Name="PrinterToFileCheck" Content="Print to file" IsChecked="True"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <StackPanel Width="370">
                            <GroupBox Header="Hidden Line Views" Height="120">
                                <StackPanel><TextBlock Text="Remove Lines Using"/><RadioButton x:Name="VectorRadio" Content="Vector Processing" IsChecked="True"/><RadioButton x:Name="RasterRadio" Content="Raster Processing"/></StackPanel>
                            </GroupBox>
                            <GroupBox Header="Appearance" Height="175">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Raster Quality" VerticalAlignment="Center"/><ComboBox x:Name="RasterQualityCombo" Grid.Column="1"><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Presentation"/></ComboBox>
                                    <TextBlock Grid.Row="1" Text="Colors" VerticalAlignment="Center" Margin="0,12,0,0"/><ComboBox x:Name="ColorModeCombo" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"><ComboBoxItem Content="Color"/><ComboBoxItem Content="GrayScale"/><ComboBoxItem Content="BlackLine"/></ComboBox>
                                </Grid>
                            </GroupBox>
                            <Expander Header="Other format settings" Margin="0,0,14,0">
                                <StackPanel Margin="8">
                                    <TextBlock Text="DWG setup"/><ComboBox x:Name="DwgSetupCombo" Margin="0,3,0,7"/>
                                    <TextBlock Text="DGN setup"/><ComboBox x:Name="DgnSetupCombo" Margin="0,3,0,7"/>
                                    <CheckBox x:Name="CombineDwfCheck" Content="Combine DWF"/>
                                    <StackPanel Orientation="Horizontal"><ComboBox x:Name="ImageFormatCombo" Width="120"><ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPEGLossless"/><ComboBoxItem Content="TIFF"/><ComboBoxItem Content="BMP"/></ComboBox><ComboBox x:Name="ImageResolutionCombo" Width="120" Margin="7,0,0,0"><ComboBoxItem Content="DPI_72"/><ComboBoxItem Content="DPI_150"/><ComboBoxItem Content="DPI_300"/><ComboBoxItem Content="DPI_600"/></ComboBox></StackPanel>
                                    <Button Content="Advanced format settings..." Margin="0,8,0,0" HorizontalAlignment="Left" Click="OpenAdvancedFormatSettings"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <StackPanel Width="370">
                            <GroupBox Header="Options" Height="255">
                                <StackPanel>
                                    <CheckBox x:Name="LinksBlueCheck" Content="View links in blue (Color prints only)"/>
                                    <CheckBox x:Name="HideReferenceCheck" Content="Hide ref/work planes"/>
                                    <CheckBox x:Name="HideTagsCheck" Content="Hide unreferenced view tags"/>
                                    <CheckBox x:Name="HideScopeCheck" Content="Hide scope boxes"/>
                                    <CheckBox x:Name="HideCropCheck" Content="Hide crop boundaries"/>
                                    <CheckBox x:Name="HalftoneCheck" Content="Replace halftone with thin lines"/>
                                    <CheckBox x:Name="MaskLinesCheck" Content="Region edges mask coincident lines"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="File" Height="200">
                                <StackPanel>
                                    <RadioButton x:Name="SeparateFilesRadio" Content="Create separate files" IsChecked="True" Checked="OptionStateChanged"/>
                                    <RadioButton x:Name="CombinedFilesRadio" Content="Combine multiple views/sheets into a single file" Checked="OptionStateChanged"/>
                                    <CheckBox x:Name="CombinePdfCheck" Content="Keep Paper Size &amp; Orientation" Checked="OptionStateChanged" Unchecked="OptionStateChanged"/>
                                    <TextBox x:Name="CombinedPdfNameBox" Width="230" HorizontalAlignment="Left" Margin="23,6,0,0"/>
                                    <CheckBox x:Name="AlwaysRasterCheck" Content="Always use raster processing" Visibility="Collapsed"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </WrapPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Create">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <GroupBox Header="Export Rules" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="420"/><ColumnDefinition Width="*" MinWidth="190"/></Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Folder Selection" VerticalAlignment="Center"/><TextBox x:Name="OutputFolderBox" Grid.Column="1"/><Button Grid.Column="2" Content="..." Margin="5,0,0,0" Padding="2" Click="BrowseFolder"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Supports environment variables." Foreground="#646464" Margin="0,4,0,4"/>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal"><StackPanel><RadioButton x:Name="SameFolderRadio" Content="Save all files in the same folder location" IsChecked="True" Checked="OptionStateChanged"/><RadioButton x:Name="SplitFolderRadio" Content="Save and split files by file format" Checked="OptionStateChanged"/></StackPanel><ComboBox x:Name="ReportModeCombo" Width="205" Margin="18,0,0,0" VerticalAlignment="Center"><ComboBoxItem Content="Don't Save Report" Tag="None"/><ComboBoxItem Content="Save CSV Report" Tag="CSV"/><ComboBoxItem Content="Save XLSX Report" Tag="XLSX"/><ComboBoxItem Content="Save CSV + XLSX" Tag="Both"/></ComboBox></StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="20,0,10,0">
                                <TextBlock x:Name="CreateSummaryText" Text="Completed 0%" FontSize="15"/>
                                <ProgressBar x:Name="ExportProgress" Height="20" Minimum="0" Maximum="1" Margin="0,12,0,0"/>
                                <TextBlock x:Name="ProgressDetailsText" Foreground="#666666" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#F1F1F1">
                        <WrapPanel Margin="5">
                            <Button x:Name="PaperSizeButton" Content="Set Paper Size  v" Click="OpenPaperSizeMenu">
                                <Button.ContextMenu><ContextMenu>
                                    <MenuItem Header="Automatic" Tag="Default" Click="SetPaperSize"/>
                                    <MenuItem Header="A0" Tag="ISO_A0" Click="SetPaperSize"/>
                                    <MenuItem Header="A1" Tag="ISO_A1" Click="SetPaperSize"/>
                                    <MenuItem Header="A2" Tag="ISO_A2" Click="SetPaperSize"/>
                                    <MenuItem Header="A3" Tag="ISO_A3" Click="SetPaperSize"/>
                                    <MenuItem Header="A4" Tag="ISO_A4" Click="SetPaperSize"/>
                                    <Separator/>
                                    <MenuItem Header="ISO B1 (707 x 1000 mm)" Tag="ISO_B1" Click="SetPaperSize"/>
                                    <MenuItem Header="ISO B2 (500 x 707 mm)" Tag="ISO_B2" Click="SetPaperSize"/>
                                    <MenuItem Header="ISO B3 (353 x 500 mm)" Tag="ISO_B3" Click="SetPaperSize"/>
                                    <MenuItem Header="ISO B4 (250 x 353 mm)" Tag="ISO_B4" Click="SetPaperSize"/>
                                    <Separator/>
                                    <MenuItem Header="ANSI A" Tag="ANSI_A" Click="SetPaperSize"/>
                                    <MenuItem Header="ANSI B" Tag="ANSI_B" Click="SetPaperSize"/>
                                    <MenuItem Header="ANSI C" Tag="ANSI_C" Click="SetPaperSize"/>
                                    <MenuItem Header="ANSI D" Tag="ANSI_D" Click="SetPaperSize"/>
                                    <MenuItem Header="ANSI E" Tag="ANSI_E" Click="SetPaperSize"/>
                                    <Separator/>
                                    <MenuItem Header="ARCH A (9 x 12 in)" Tag="ARCH_A" Click="SetPaperSize"/>
                                    <MenuItem Header="ARCH B (12 x 18 in)" Tag="ARCH_B" Click="SetPaperSize"/>
                                    <MenuItem Header="ARCH C (18 x 24 in)" Tag="ARCH_C" Click="SetPaperSize"/>
                                    <MenuItem Header="ARCH D (24 x 36 in)" Tag="ARCH_D" Click="SetPaperSize"/>
                                    <MenuItem Header="ARCH E (36 x 48 in)" Tag="ARCH_E" Click="SetPaperSize"/>
                                    <MenuItem Header="ARCH E1 (30 x 42 in)" Tag="ARCH_E1" Click="SetPaperSize"/>
                                    <MenuItem Header="ARCH E2 (26 x 38 in)" Tag="ARCH_E2" Click="SetPaperSize"/>
                                    <MenuItem Header="ARCH E3 (27 x 39 in)" Tag="ARCH_E3" Click="SetPaperSize"/>
                                </ContextMenu></Button.ContextMenu>
                            </Button>
                            <Button x:Name="OrientationButton" Content="Set Orientation  v" Margin="6,0,0,0" Click="OpenOrientationMenu">
                                <Button.ContextMenu><ContextMenu>
                                    <MenuItem Header="Automatic" Tag="Auto" Click="SetOrientation"/>
                                    <MenuItem Header="Landscape" Tag="Landscape" Click="SetOrientation"/>
                                    <MenuItem Header="Portrait" Tag="Portrait" Click="SetOrientation"/>
                                </ContextMenu></Button.ContextMenu>
                            </Button>
                            <Button Content="Up" Margin="12,0,0,0" Click="MoveRowsUp"/>
                            <Button Content="Down" Margin="5,0,0,0" Click="MoveRowsDown"/>
                            <Button Content="Remove" Margin="5,0,0,0" Click="RemoveRows"/>
                            <Button x:Name="RetryButton" Content="Retry Failed" Margin="5,0,0,0" IsEnabled="False" Click="RetryFailed"/>
                            <CheckBox x:Name="SplitByFormatCheck" Content="Split files by format" Visibility="Collapsed"/>
                            <CheckBox x:Name="CreateReportCheck" Content="Create CSV report" Visibility="Collapsed"/>
                            <TextBlock Text="File naming" VerticalAlignment="Center" Margin="12,0,7,0"/>
                            <TextBox x:Name="NamingPatternBox" Width="220" ToolTip="File-name template"/>
                            <Button x:Name="NamingTokensButton" Content="Tokens..." Margin="5,0,0,0" Click="OpenNamingTokens"/>
                        </WrapPanel>
                    </Border>

                    <DataGrid x:Name="SummaryGrid" Grid.Row="2" Height="300" MinWidth="650" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" SelectionMode="Extended" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="50" MinWidth="45" Binding="{Binding Order}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="View/Sheet Number" Width="170" MinWidth="120" Binding="{Binding Number}"/>
                            <DataGridTextColumn Header="View/Sheet Name" Width="300" MinWidth="180" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Format" Width="105" MinWidth="85" Binding="{Binding Format}"/>
                            <DataGridTextColumn Header="Size" Width="135" MinWidth="100" Binding="{Binding Size}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Orientation" Width="125" MinWidth="105" Binding="{Binding Orientation}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Progress" Width="180" MinWidth="130" Binding="{Binding Progress}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="3" Header="Scheduling Assistant" Margin="0,10,0,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <WrapPanel><CheckBox x:Name="ScheduleCheck" Content="Schedule Publish" Checked="OptionStateChanged" Unchecked="OptionStateChanged"/><TextBlock x:Name="ScheduleStatusText" Text="The Scheduling Assistant is off." VerticalAlignment="Center" Margin="15,0,0,0"/><Button Content="Manage schedules" Height="30" MinHeight="30" Margin="14,0,0,0" Click="ManageSchedules"/><Button Content="Refresh" Height="30" MinHeight="30" Margin="6,0,0,0" Click="RefreshView"/></WrapPanel>
                            <StackPanel Grid.Row="1" Margin="0,12,0,0"><WrapPanel><TextBlock Text="Choose Starting Date:" VerticalAlignment="Center"/><DatePicker x:Name="ScheduleDate" Width="180" Margin="8,0,18,0"/><TextBlock Text="Choose Time" VerticalAlignment="Center"/><TextBox x:Name="ScheduleTimeBox" Width="100" Margin="8,0,10,0"/><ComboBox x:Name="RepeatCombo" Width="145" SelectionChanged="RepeatChanged"><ComboBoxItem Content="Once"/><ComboBoxItem Content="Daily"/><ComboBoxItem Content="Weekly"/><ComboBoxItem Content="Monthly"/></ComboBox></WrapPanel><WrapPanel x:Name="WeekdayPanel" Margin="0,7,0,0" IsEnabled="False"><TextBlock Text="Days:" VerticalAlignment="Center" Margin="0,0,8,0"/><CheckBox x:Name="MonCheck" Content="Mon"/><CheckBox x:Name="TueCheck" Content="Tue"/><CheckBox x:Name="WedCheck" Content="Wed"/><CheckBox x:Name="ThuCheck" Content="Thu"/><CheckBox x:Name="FriCheck" Content="Fri"/><CheckBox x:Name="SatCheck" Content="Sat"/><CheckBox x:Name="SunCheck" Content="Sun"/></WrapPanel></StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="14,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#555555"/>
                <TextBlock x:Name="DocumentText" Foreground="#777777" Margin="0,3,0,0"/>
            </StackPanel>
            <TextBlock x:Name="GlobalScheduleText" Grid.Column="1" Text="The scheduling assistant is: Off" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Settings" Style="{StaticResource GoldButton}" Click="OpenSettings"/>
                <Button x:Name="BackButton" Content="Back" Width="112" Margin="8,0,0,0" Click="BackStep"/>
                <Button x:Name="NextButton" Content="Next" Width="112" Margin="8,0,0,0" Click="NextStep"/>
                <Button x:Name="CreateButton" Content="Create" Width="112" Margin="8,0,0,0" Click="CreateExport"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
