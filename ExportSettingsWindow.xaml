<Window x:Class="KrakhmalovSheets.ExportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMLEADERS Sheets - Export Settings" Width="900" Height="620"
        MinWidth="720" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="#F2F2F2" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#C9D4DA"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Width" Value="105"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Temporary Hide/Isolate">
                    <StackPanel>
                        <RadioButton x:Name="DisableTemporaryHideRadio" Content="Turn off the Temporary Hide/Isolate mode before exporting"/>
                        <RadioButton x:Name="KeepTemporaryHideRadio" Content="Leave the Temporary Hide/Isolate mode and export"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Worksharing Display">
                    <StackPanel>
                        <RadioButton x:Name="DisableWorksharingRadio" Content="Turn off the Worksharing Display mode before exporting"/>
                        <RadioButton x:Name="KeepWorksharingRadio" Content="Leave the Worksharing Display mode on and export"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Reveal Hidden Elements">
                    <StackPanel>
                        <RadioButton x:Name="DisableRevealHiddenRadio" Content="Turn off the Reveal Hidden Elements mode before exporting"/>
                        <RadioButton x:Name="KeepRevealHiddenRadio" Content="Leave the Reveal Hidden Elements mode on and export"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Reveal Constraints">
                    <StackPanel>
                        <RadioButton x:Name="DisableRevealConstraintsRadio" Content="Turn off the Reveal Constraints mode before exporting"/>
                        <RadioButton x:Name="KeepRevealConstraintsRadio" Content="Leave the Reveal Constraints mode on and export"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" IsCancel="True"/>
            <Button Content="Save" IsDefault="True" Click="SaveSettings" Background="#EAB143" BorderBrush="#C88B16" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
