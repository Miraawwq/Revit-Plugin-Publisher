<Window x:Class="MiraSHA.Sheets.AdvancedFormatSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiraSHA Sheets - Format Settings" Width="1040" Height="760"
        MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="#F2F2F2" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="8"/><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#C9D4DA"/><Setter Property="Background" Value="#FAFAFA"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4"/></Style>
        <Style TargetType="TextBox"><Setter Property="MinHeight" Value="29"/><Setter Property="Margin" Value="0,3,0,7"/></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="29"/><Setter Property="Margin" Value="0,3,0,7"/></Style>
        <Style TargetType="Button"><Setter Property="Width" Value="105"/><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="DWG / DGN">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel Margin="8">
                    <GroupBox Header="DWG" Width="430"><StackPanel>
                        <CheckBox x:Name="DwgMergedViewsCheck" Content="Export views on sheets and links as external references"/>
                        <CheckBox x:Name="DwgBindImagesCheck" Content="Bind raster images after export (requires AutoCAD)" IsEnabled="False" ToolTip="Revit API cannot bind images as OLE without an AutoCAD post-process."/>
                        <CheckBox x:Name="DwgCleanPcpCheck" Content="Delete generated PCP files"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="DGN" Width="430"><StackPanel>
                        <CheckBox x:Name="DgnMergedViewsCheck" Content="Export views on sheets as references"/>
                    </StackPanel></GroupBox>
                </WrapPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="DWF / DWFX">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel Margin="8">
                    <GroupBox Header="File" Width="430"><StackPanel>
                        <TextBlock Text="File type"/><ComboBox x:Name="DwfTypeCombo"><ComboBoxItem Content="DWF"/><ComboBoxItem Content="DWFX"/></ComboBox>
                        <TextBlock Text="Combined file name"/><TextBox x:Name="DwfCombinedNameBox"/>
                        <CheckBox x:Name="DwfCropBoxCheck" Content="Show crop box"/>
                        <CheckBox x:Name="DwfObjectDataCheck" Content="Export object data"/>
                        <CheckBox x:Name="DwfTexturesCheck" Content="Export textures"/>
                        <CheckBox x:Name="DwfAreasCheck" Content="Export areas"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Image" Width="430"><StackPanel>
                        <TextBlock Text="Image quality"/><ComboBox x:Name="DwfQualityCombo"><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/></ComboBox>
                        <TextBlock Text="Image format"/><ComboBox x:Name="DwfImageFormatCombo"><ComboBoxItem Content="Lossless"/><ComboBoxItem Content="Lossy"/></ComboBox>
                    </StackPanel></GroupBox>
                </WrapPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="NWC">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel Margin="8">
                    <GroupBox Header="Scope and geometry" Width="430"><StackPanel>
                        <CheckBox x:Name="NwcWholeModelCheck" Content="Export the whole model instead of selected 3D views"/>
                        <TextBlock Text="Coordinates"/><ComboBox x:Name="NwcCoordinatesCombo"><ComboBoxItem Content="Internal"/><ComboBoxItem Content="Shared"/></ComboBox>
                        <TextBlock Text="Parameters"/><ComboBox x:Name="NwcParametersCombo"><ComboBoxItem Content="All"/><ComboBoxItem Content="Elements"/></ComboBox>
                        <TextBlock Text="Faceting factor (0.01 - 10)"/><TextBox x:Name="NwcFacetingBox"/>
                        <CheckBox x:Name="NwcLevelsCheck" Content="Divide file into levels"/><CheckBox x:Name="NwcPartsCheck" Content="Export parts"/><CheckBox x:Name="NwcRoomGeometryCheck" Content="Export room geometry"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Data" Width="430"><StackPanel>
                        <CheckBox x:Name="NwcLinkedCadCheck" Content="Convert linked CAD formats"/><CheckBox x:Name="NwcLightsCheck" Content="Convert lights"/><CheckBox x:Name="NwcPropertiesCheck" Content="Convert element properties"/><CheckBox x:Name="NwcMaterialsCheck" Content="Find missing materials"/><CheckBox x:Name="NwcUrlsCheck" Content="Export URLs"/><CheckBox x:Name="NwcRoomAttributeCheck" Content="Export room as attribute"/><CheckBox x:Name="NwcLinksCheck" Content="Export Revit links"/><CheckBox x:Name="NwcIdsCheck" Content="Export element IDs"/>
                    </StackPanel></GroupBox>
                </WrapPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="IFC">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel Margin="8">
                    <GroupBox Header="File and location" Width="310"><StackPanel>
                        <TextBlock Text="IFC version"/><ComboBox x:Name="IfcVersionCombo"><ComboBoxItem Content="IFC2x3"/><ComboBoxItem Content="IFC2x3CV2"/><ComboBoxItem Content="IFC4"/><ComboBoxItem Content="IFC4RV"/><ComboBoxItem Content="IFC4DTV"/></ComboBox>
                        <TextBlock Text="File type"/><ComboBox x:Name="IfcFileTypeCombo"><ComboBoxItem Content="Ifc"/><ComboBoxItem Content="IfcXML"/><ComboBoxItem Content="IfcZIP"/></ComboBox>
                        <TextBlock Text="Space boundary level"/><ComboBox x:Name="IfcBoundaryCombo"><ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/></ComboBox>
                        <TextBlock Text="Site placement"/><ComboBox x:Name="IfcSitePlacementCombo" IsEditable="True"><ComboBoxItem Content="Current Shared Coordinates"/><ComboBoxItem Content="Project Base Point"/><ComboBoxItem Content="Survey Point"/><ComboBoxItem Content="Internal Origin"/></ComboBox>
                        <TextBlock Text="Phase element id"/><TextBox x:Name="IfcPhaseBox"/>
                        <TextBlock Text="Family mapping file"/><TextBox x:Name="IfcMappingBox"/>
                        <TextBlock Text="Category mapping"/><TextBox x:Name="IfcCategoryMappingBox"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Content" Width="310"><StackPanel>
                        <CheckBox x:Name="IfcBaseQuantitiesCheck" Content="Export base quantities"/><CheckBox x:Name="IfcSplitCheck" Content="Split walls and columns by level"/><CheckBox x:Name="IfcSteelCheck" Content="Include steel elements"/><CheckBox x:Name="IfcVisibleCheck" Content="Export only elements visible in view"/><CheckBox x:Name="Ifc2dCheck" Content="Export 2D elements"/><CheckBox x:Name="IfcLinksCheck" Content="Export linked files"/><CheckBox x:Name="IfcRoomsCheck" Content="Export rooms in view"/><CheckBox x:Name="IfcPartsCheck" Content="Export parts as building elements"/><CheckBox x:Name="IfcRevitPsetsCheck" Content="Export Revit property sets"/><CheckBox x:Name="IfcCommonPsetsCheck" Content="Export IFC common property sets"/><CheckBox x:Name="IfcActiveGeometryCheck" Content="Use active view geometry"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Property sets and geometry" Width="310"><StackPanel>
                        <CheckBox x:Name="IfcSchedulesCheck" Content="Export schedules as property sets"/><CheckBox x:Name="IfcSpecificSchedulesCheck" Content="Only schedules containing IFC"/><CheckBox x:Name="IfcUserPsetsCheck" Content="Export user-defined property sets"/><TextBlock Text="User Psets file"/><TextBox x:Name="IfcUserPsetsFileBox"/><CheckBox x:Name="IfcParameterMapCheck" Content="Use parameter mapping table"/><TextBlock Text="Parameter mapping file"/><TextBox x:Name="IfcParameterMapFileBox"/><TextBlock Text="Tessellation level"/><ComboBox x:Name="IfcTessellationCombo"><ComboBoxItem Content="Extra Low"/><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/></ComboBox>
                        <CheckBox x:Name="IfcSolidCheck" Content="Allow mixed solid representation"/><CheckBox x:Name="IfcFamilyNameCheck" Content="Use family and type name for reference"/><CheckBox x:Name="Ifc2dRoomCheck" Content="Use 2D room boundaries"/><CheckBox x:Name="IfcSiteElevationCheck" Content="Include site elevation"/><CheckBox x:Name="IfcGuidCheck" Content="Store IFC GUID"/><CheckBox x:Name="IfcBoundingBoxCheck" Content="Export bounding box"/><CheckBox x:Name="IfcTriangulationCheck" Content="Use only triangulation"/><CheckBox x:Name="IfcTypeNameOnlyCheck" Content="Use type name only for IFC type"/><CheckBox x:Name="IfcVisibleNameCheck" Content="Use visible Revit name as entity name"/>
                    </StackPanel></GroupBox>
                </WrapPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Image / XML">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel Margin="8">
                    <GroupBox Header="Image" Width="430"><StackPanel>
                        <TextBlock Text="Fit direction"/><ComboBox x:Name="ImageFitCombo"><ComboBoxItem Content="Horizontal"/><ComboBoxItem Content="Vertical"/></ComboBox>
                        <TextBlock Text="Zoom type"/><ComboBox x:Name="ImageZoomTypeCombo"><ComboBoxItem Content="FitToPage"/><ComboBoxItem Content="Zoom"/></ComboBox>
                        <TextBlock Text="Shadow view file type"/><ComboBox x:Name="ImageShadowFormatCombo"><ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPEGLossless"/><ComboBoxItem Content="JPEGLossy"/><ComboBoxItem Content="TIFF"/><ComboBoxItem Content="BMP"/></ComboBox>
                        <TextBlock Text="Pixel size"/><TextBox x:Name="ImagePixelBox"/><TextBlock Text="Zoom percent"/><TextBox x:Name="ImageZoomBox"/>
                        <CheckBox x:Name="ImageWebsiteCheck" Content="Create HTML website"/><TextBlock Text="Website name"/><TextBox x:Name="ImageWebsiteNameBox"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="XML" Width="430"><StackPanel>
                        <CheckBox x:Name="XmlParametersCheck" Content="Include sheet/view parameters"/><CheckBox x:Name="XmlProjectParametersCheck" Content="Include project parameters"/><CheckBox x:Name="XmlOneFileCheck" Content="Create one XML file per item"/>
                    </StackPanel></GroupBox>
                </WrapPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Cancel" IsCancel="True"/><Button Content="Save" IsDefault="True" Click="SaveSettings" Background="#EAB143" BorderBrush="#C88B16" Foreground="White"/></StackPanel>
    </Grid>
</Window>
