<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MiraSHA.Sheets</AssemblyName>
    <RootNamespace>MiraSHA.Sheets</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <Version>1.4.0</Version>
    <InformationalVersion>1.4.0</InformationalVersion>
    <Company>MiraSHA</Company>
    <Product>MiraSHA Sheets</Product>
    <Title>MiraSHA Sheets</Title>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>
    <OutputPath>bin\$(Configuration)\Revit$(RevitVersion)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\Revit$(RevitVersion)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PublishIcon32.png" />
    <Resource Include="Assets\PublishIcon16.png" />
  </ItemGroup>
</Project>
