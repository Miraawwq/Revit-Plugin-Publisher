<Window x:Class="MiraSHA.Sheets.ScheduleManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiraSHA Sheets - Scheduled Exports" Width="980" Height="520"
        MinWidth="760" MinHeight="400" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="#F2F2F2">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGrid x:Name="JobsGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="75"/>
                <DataGridTextColumn Header="Project" Binding="{Binding DocumentTitle}" Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="Next run" Binding="{Binding NextRun}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Repeat" Binding="{Binding Repeat}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Items" Binding="{Binding ItemUniqueIds.Count}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Last run" Binding="{Binding LastRun}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Last error" Binding="{Binding LastError}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Delete" Width="105" Height="34" Click="DeleteJob"/>
            <Button Content="Save" Width="105" Height="34" Margin="8,0,0,0" Click="SaveJobs"/>
            <Button Content="Close" Width="105" Height="34" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
